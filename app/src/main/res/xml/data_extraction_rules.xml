<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup / device-transfer rules.
    The Room database (a-flash-deck.db) IS included in cloud backup and
    device-to-device transfer. Only its SQLite shared-memory side file
    (a-flash-deck.db-shm, regenerated when the database is opened), the
    transient serialized in-progress test session files (test/state) and
    the encrypted Gemini API key (ai_secure_prefs) are excluded.
    The API key is Keystore-encrypted but the ciphertext should not be
    restored onto another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_secure_prefs.xml" />
        <exclude domain="database" path="a-flash-deck.db-shm" />
        <exclude domain="file" path="test/state" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_secure_prefs.xml" />
        <exclude domain="database" path="a-flash-deck.db-shm" />
        <exclude domain="file" path="test/state" />
    </device-transfer>
</data-extraction-rules>
